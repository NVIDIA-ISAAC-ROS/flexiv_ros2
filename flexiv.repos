# ABI-locked source snapshot of ros2_control and ros2_controllers for the
# Flexiv driver.
#
# Rationale:
#   * ros2_control and ros2_controllers share a C++ ABI boundary via
#     controller_interface. Mixing versions from different Jazzy snapshots
#     causes SIGSEGV in controller on_activate() when controller_manager
#     loads them.
#   * packages.ros.org periodically purges older Jazzy snapshot .debs
#     (e.g. the 20260124 snapshot is no longer available), so apt-pinning
#     is not durable. Git tags are permanent, so we build from source.
#   * Do not apt-pin Fast-DDS/Fast-CDR to older patch releases. Current
#     Jazzy needs Fast-CDR >= 2.2.7; flexiv_rdk v1.8 stack-smashes against
#     it. This branch pins flexiv_hardware/rdk to v1.9.2 instead.
#
# Import:
#   cd ${ISAAC_ROS_WS}
#   vcs import src < src/flexiv_ros2/flexiv.repos
repositories:
  third_party/ros2_control:
    type: git
    url: https://github.com/ros-controls/ros2_control.git
    version: 4.42.2
  third_party/ros2_controllers:
    type: git
    url: https://github.com/ros-controls/ros2_controllers.git
    version: 4.36.0
